# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyc
*.egg-info/

# OS native extensions (generated builds) — EXCEPT in src/vendored/ (ATK official files)
*.pyd
*.so
!src/vendored/*.pyd
!src/vendored/*.so
!src/vendored/*.cpython-38-aarch64-linux-gnu.so

# vendored/__pycache__/ and src/vendored/__pycache__/
__pycache__/
vendored/__pycache__/
src/vendored/__pycache__/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
*.cover

# Distribution / packaging
dist/
build/
.eggs/

# Virtual environments
.env
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
site/

# Claude Code
.claude/
